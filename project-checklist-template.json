          "name": "📋 客户对接",
          "tasks": [
            {"id": "t1_1", "text": "收集客户需求表", "expandable": true, "subTasks": ["生活方式调查", "家庭成员结构", "预算范围确认", "风格偏好（参考图）", "功能需求清单"]},
            {"id": "t1_2", "text": "安排现场测量", "expandable": true, "subTasks": ["预约测量时间", "准备测量工具", "拍摄现场照片", "记录现有条件"]},
            {"id": "t1_3", "text": "收取设计定金", "expandable": false, "subTasks": []}
          ]
        },
        {
          "id": "phase2",
          "name": "📐 设计阶段",
          "tasks": [
            {"id": "t2_1", "text": "2D 平面图规划", "expandable": true, "subTasks": ["空间布局优化", "家具摆放确认", "动线规划", "采光分析"]},
            {"id": "t2_2", "text": "3D 概念渲染图", "expandable": true, "subTasks": ["客厅渲染", "主卧渲染", "厨房渲染（如有）", "整体氛围图"]},
            {"id": "t2_3", "text": "材料清单确认", "expandable": true, "subTasks": ["地板材料", "油漆颜色", "灯具选择", "五金配件", "家具推荐"]},
            {"id": "t2_4", "text": "客户审阅 & 修改", "expandable": true, "subTasks": ["第一轮审阅反馈", "修改平面图", "修改渲染图", "第二轮审阅确认"]}
          ]
        },
        {
          "id": "phase3",
          "name": "✅ 设计定稿",
          "tasks": [
            {"id": "t3_1", "text": "客户签署最终设计确认", "expandable": false, "subTasks": []},
            {"id": "t3_2", "text": "输出最终图纸（CAD/PDF）", "expandable": true, "subTasks": ["2D 平面图", "3D 渲染图", "材料清单规格", "电工配置图", "水管配置图"]},
            {"id": "t3_3", "text": "工程预算表（BOQ）准备", "expandable": true, "subTasks": ["材料数量计算", "人工费用估算", "利润加成", "报价单整理"]}
          ]
        },
        {
          "id": "phase4",
          "name": "💰 结算 & 交付",
          "tasks": [
            {"id": "t4_1", "text": "收取设计费尾款", "expandable": false, "subTasks": []},
            {"id": "t4_2", "text": "移交设计文件", "expandable": true, "subTasks": ["PDF 文件包", "CAD 源文件", "材料采购清单", "供应商联系方式"]},
            {"id": "t4_3", "text": "记录项目存档", "expandable": false, "subTasks": []},
            {"id": "t4_4", "text": "邀请 Google Review", "expandable": false, "subTasks": []}
          ]
        }
      ]
    },
